# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/sites-vite-plugin.LICENSE
!/build/sites-vite-plugin.ts
!/build/sites-worker.ts

/dist/
# Local development database and tool state; never publish them.
/.data/
/.agents/
/.codex/
/outputs/
/work/

# Operational files stay outside the public source repository.
*.sqlite
*.sqlite-*
*.db
*.db-*
*.xlsx
*.xls
*.csv
*.tsbuildinfo
/inventory-exports/
/backups/
# Full-size uniform photos; scripts/uniform-images.py commits small copies to app/assets/uniforms.
/assets/

/tmp/

/release-out/
